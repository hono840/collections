{
  "name": "drive-spots",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "22.x",
    "pnpm": ">=10.16.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next dev",
    "build": "next build && node scripts/csp/inject-meta-csp.mjs out && node scripts/csp/verify-out.mjs out",
    "start": "node scripts/serve-static.mjs out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.3.4",
      "brace-expansion@<1.1.18": "^1.1.18",
      "brace-expansion@>=5.0.0 <5.0.9": "^5.0.9",
      "browserslist@<4.28.7": "^4.28.7",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "nanoid@<3.3.18": "^3.3.18",
      "postcss@<8.5.18": "^8.5.18",
      "undici@>=7.0.0 <7.30.1": "^7.30.1",
      "source-map-js@<1.2.2": "^1.2.2",
      "zod@<4.6.6": "^4.6.6"
    }
  }
}
